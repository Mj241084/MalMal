DJANGO_SETTINGS_MODULE=config.settings.prod
PY=/srv/malmal/.venv/bin/python
*/5  * * * * cd /srv/malmal && $PY manage.py expire_orders
*/10 * * * * cd /srv/malmal && $PY manage.py send_back_in_stock
15 3 * * *   cd /srv/malmal && $PY manage.py recount_purchases
20 3 * * *   cd /srv/malmal && $PY manage.py reconcile_counters
30 3 * * *   cd /srv/malmal && $PY manage.py warm_cache
40 3 * * *   cd /srv/malmal && $PY manage.py purge_otp
45 3 * * *   cd /srv/malmal && $PY manage.py purge_sms_logs
50 3 * * *   cd /srv/malmal && $PY manage.py backup_db --with-media
