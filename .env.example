# --- Django Core ---
# Secret key for cryptographic signing (required in production; generate via: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=
# Debug mode: true for local development, false in production
DEBUG=
# Comma-separated allowed hostnames (e.g. malmal.ir,www.malmal.ir)
ALLOWED_HOSTS=
# Public base URL without trailing slash (default in dev: http://localhost:8000)
SITE_URL=
# Admin panel path without leading slash (default in dev: admin/; change to non-default path in production)
ADMIN_URL=

# --- Cache & Rate Limit (Redis) ---
# Redis connection URL (required in production; default in dev: redis://127.0.0.1:6379/1)
REDIS_URL=

# --- SMS (sms.ir) ---
# SMS backend: "console" (dev default) or "smsir"
SMS_BACKEND=
# sms.ir API key (X-API-KEY)
SMSIR_API_KEY=
# sms.ir template ID for OTP verification code
SMSIR_TEMPLATE_ID_OTP=
# sms.ir template ID sent after successful order payment
SMSIR_TEMPLATE_ID_ORDER_PAID=
# sms.ir template ID sent when order ships with tracking code
SMSIR_TEMPLATE_ID_ORDER_SHIPPED=
# sms.ir template ID sent when order ships via courier without tracking code
SMSIR_TEMPLATE_ID_ORDER_SHIPPED_COURIER=
# sms.ir template ID sent on order delivery
SMSIR_TEMPLATE_ID_ORDER_DELIVERED=
# sms.ir template ID sent on order cancellation
SMSIR_TEMPLATE_ID_ORDER_CANCELLED=
# sms.ir template ID sent on order refund
SMSIR_TEMPLATE_ID_ORDER_REFUNDED=
# sms.ir template ID for back-in-stock notifications
SMSIR_TEMPLATE_ID_BACK_IN_STOCK=
# sms.ir template ID for admin new-order notification
SMSIR_TEMPLATE_ID_ADMIN_NEW_ORDER=
# Comma-separated staff mobile numbers for new-order SMS alerts
SMS_ADMIN_MOBILES=

# --- Map (Neshan) ---
# Neshan web map SDK key (restricted to domain in production)
NESHAN_MAP_KEY=
# Neshan REST service key (reverse geocoding / address search, optional)
NESHAN_SERVICE_KEY=

# --- Payment Gateway (Zarinpal) ---
# Zarinpal merchant ID (36-char UUID)
ZARINPAL_MERCHANT_ID=
# Use Zarinpal sandbox: "true" (default) or "false" in production
ZARINPAL_SANDBOX=

# --- Network / Proxy ---
# Trusted reverse proxy IPs for reading client IP; empty = use REMOTE_ADDR only
TRUSTED_PROXY_IPS=

# --- Production / Deployment ---
# Folder for nightly SQLite backups (outside the project, ideally on another disk)
BACKUP_DIR=
# Force https redirects (default in production: true)
SSL_REDIRECT=
# HSTS max-age in seconds (default: 2592000 = 30 days)
HSTS_SECONDS=
# Comma-separated https origins Django accepts for CSRF (default: SITE_URL)
CSRF_TRUSTED_ORIGINS=
